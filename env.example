# Copie este arquivo para ".env" e preencha as chaves. NUNCA faça commit do .env.
#   cp env.example .env

# --- LLM: provedor padrão OpenAI. Chave em https://platform.openai.com/api-keys (exige crédito)
SRAG_PROVIDER=openai
OPENAI_API_KEY=<SUA_CHAVE_AQUI>
# Alternativas (troque SRAG_PROVIDER e preencha a chave correspondente)
# SRAG_PROVIDER=anthropic   # ANTHROPIC_API_KEY (https://console.anthropic.com, exige crédito)
# SRAG_PROVIDER=gemini      # GOOGLE_API_KEY (https://aistudio.google.com/apikey, free tier)
# SRAG_PROVIDER=groq        # GROQ_API_KEY (https://console.groq.com/keys, free tier)
# SRAG_MODEL=               # vazio = padrão do provedor

# --- Banco de dados (Supabase): os marts agregados são lidos daqui.
# Quem só quer rodar o relatório usa a conexão SOMENTE LEITURA publicada no README.
# Quem publica os marts (--publish-supabase) usa a conexão do dono do projeto.
# Use a string do "pooler" (Connect > Session pooler), que funciona em redes sem IPv6.
SUPABASE_DB_URL=postgresql://<usuario>:<senha>@<host-do-pooler>:5432/postgres

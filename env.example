# Copie este arquivo para ".env" e preencha a chave. NUNCA faça commit do .env.
#   cp env.example .env

# Provedor padrão: Gemini (free tier). Chave grátis em https://aistudio.google.com/apikey
SRAG_PROVIDER=gemini
GOOGLE_API_KEY=<SUA_CHAVE_AQUI>

# Alternativas (troque SRAG_PROVIDER e preencha a chave correspondente)
# SRAG_PROVIDER=groq        # GROQ_API_KEY (https://console.groq.com/keys)
# SRAG_PROVIDER=anthropic   # ANTHROPIC_API_KEY (pago, https://console.anthropic.com)
# SRAG_MODEL=               # vazio = padrão do provedor
